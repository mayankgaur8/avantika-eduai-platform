# ============================================================
#  Avantika EduAI — Frontend Environment Variables
#  Copy to client/.env.local for local dev (gitignored).
#  Set VITE_API_BASE_URL in Vercel/Azure Static Web Apps for production.
# ============================================================

# ── Local development ─────────────────────────────────────────
# Tells Vite's dev server to proxy /api requests to your local backend.
# Required when running `npm run dev` inside /client.
VITE_DEV_API_PROXY_TARGET=http://localhost:3000

# ── Production build ──────────────────────────────────────────
# Set this in your hosting provider (Vercel env vars / Azure Static Web Apps).
# The frontend will call this URL directly — no proxy in production.
# VITE_API_BASE_URL=https://avantika-eduai-api.azurewebsites.net/api
