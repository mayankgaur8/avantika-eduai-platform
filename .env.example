# AI_PROVIDER controls which LLM is used for Quiz and Paper generation.
# Production: use groq  (fast, free tier, no local server needed)
# Local dev:  use ollama (local) or groq
AI_PROVIDER=ollama

# ── Groq (recommended for production) ─────────────────────────
# Get free API key: https://console.groq.com/keys
# AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1   (this is the default, no need to set)

# Local backend app settings
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=local_dev_secret

# Local PostgreSQL
DATABASE_URL=postgresql://local_user:local_password@localhost:5432/local_db

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Ollama (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Shared AI platform
AI_PLATFORM_URL=http://localhost:8000
AI_PLATFORM_API_KEY=your_ai_platform_api_key

# ── Puppeteer / Chrome (Azure App Service) ───────────────────
# CI skips Chrome download (PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true).
# Set the two lines below in Azure App Settings so Chrome is fetched
# once on first cold start and cached in persistent /home storage.
# PUPPETEER_CACHE_DIR=/home/.cache/puppeteer
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false
