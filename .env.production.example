# Production backend app settings
PORT=3000
NODE_ENV=production
CLIENT_URL=https://<AZURE_FRONTEND_URL>
JWT_SECRET=<strong_production_secret>

# Azure PostgreSQL
DATABASE_URL=<Azure_PostgreSQL_connection_string>

# AI provider selection
AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=<openai_api_key>
OPENAI_MODEL=gpt-4.1-mini

# Ollama (optional; used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=<ollama_base_url>
OLLAMA_MODEL=llama3.1

# Payments
RAZORPAY_KEY_ID=<razorpay_key_id>
RAZORPAY_KEY_SECRET=<razorpay_key_secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay_webhook_secret>

# Shared AI platform
AI_PLATFORM_URL=<ai_platform_url>
AI_PLATFORM_API_KEY=<ai_platform_api_key>
